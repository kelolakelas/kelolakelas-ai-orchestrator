DATABASE_URL=postgres://ai_orchestrator:change-me@127.0.0.1:5432/ai_orchestrator
ORCHESTRATOR_CONFIG=./orchestrator.config.example.yaml
ORCHESTRATOR_DRY_RUN=false
# Enables the operator API when set. Use a long random value.
ORCHESTRATOR_OPERATOR_TOKEN=
# Optional stable identity, unique per process. When set, leases held by a previous run are recovered at startup.
ORCHESTRATOR_WORKER_ID=
LINEAR_API_KEY=
OPENAI_API_KEY=
