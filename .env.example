DATABASE_URL=postgres://ai_orchestrator:change-me@127.0.0.1:5432/ai_orchestrator
ORCHESTRATOR_CONFIG=./orchestrator.config.example.yaml
ORCHESTRATOR_DRY_RUN=false
# Enables the operator API when set. Use a long random value.
ORCHESTRATOR_OPERATOR_TOKEN=
# Optional stable identity, unique per process. When set, leases held by a previous run are recovered at startup.
ORCHESTRATOR_WORKER_ID=
LINEAR_API_KEY=
# Runner credentials reach a provider only when its alias lists them in models.providers.<alias>.environment, or in the
# deprecated agents.runner.environment. Name whichever variables the providers you configure actually read, such as
# OPENAI_API_KEY, ANTHROPIC_API_KEY, or GEMINI_API_KEY. They never reach repository quality commands.
OPENAI_API_KEY=
# Required when orchestrator.execution.deliver is true: GitHub API reads and pull request creation. Pushes use the service
# user's Git credentials. It never reaches Git, agents, or quality commands. Prefer a fine-grained token for the
# registered repositories. LINEAR_API_KEY also needs comment and attachment write access when delivery is enabled.
GITHUB_TOKEN=
